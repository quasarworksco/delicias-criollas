rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /menuPublico/{id} {
      allow read: if true;
      allow create, update: if request.resource.data.nombre is string
        && request.resource.data.categoria is string && request.resource.data.precioCentavos is int
        && request.resource.data.precioCentavos >= 0;
      allow delete: if true;
    }
    match /pedidosPanel/{id} {
      allow read: if true;
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['estado'])
        && request.resource.data.estado in ['Nuevo','En preparación','Listo','Entregado','Cancelado'];
    }
  }
}
